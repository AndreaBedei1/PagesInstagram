# ============================================================================
#  Instagram Content Engine - environment variables
#  Copy this file to ".env" and fill in real values. NEVER commit ".env".
#  Tokens are read ONLY from environment / .env, never from YAML or the DB.
# ============================================================================

# ---- Global run mode: dry_run | test | production --------------------------
# Keep dry_run until the credentials below are filled in and verified with
#   python -m src.cli instagram health-check --all
ICE_MODE=dry_run

# ---- Meta / Instagram Graph API --------------------------------------------
# Graph API version, format vNN.N. The project default matches the version used
# by Meta's own Instagram content-publishing examples, verified 2026-08-05.
# See docs/META_RESUMABLE_UPLOAD.md before changing it.
META_GRAPH_API_VERSION=v25.0

# Optional single token shared by every page. Per-page tokens below win.
META_ACCESS_TOKEN=

# ---- Per-page credentials (recommended) ------------------------------------
# Prefix = ICE_<PAGE_ID in uppercase>, matching accounts/*.yaml.
# IG_USER_ID = numeric id of the Instagram professional account.
# ACCESS_TOKEN = long-lived token (60 days, renewable before expiry).

# Pagina 1 — Pensiero Essenziale
ICE_PENSIERO_ESSENZIALE_IT_IG_USER_ID=
ICE_PENSIERO_ESSENZIALE_IT_ACCESS_TOKEN=
# Data in cui hai generato il token, YYYY-MM-DD. FACOLTATIVA ma consigliata:
# con Instagram Login la scadenza non è leggibile da nessun endpoint
# (debug_token risponde «Service temporarily unavailable» anche con credenziali
# d'app valide), quindi questa è l'unica fonte esistente. Il sistema calcola i
# 60 giorni documentati e avvisa sotto i 10 rimanenti.
# È un dato DICHIARATO, non verificato, e health-check lo dice ogni volta.
# ICE_PENSIERO_ESSENZIALE_IT_TOKEN_ISSUED_AT=

# Pagina 2 — Curiosità dal Mondo
ICE_CURIOSITA_MONDO_IT_IG_USER_ID=
ICE_CURIOSITA_MONDO_IT_ACCESS_TOKEN=

# Pagina 3 — Parola del Giorno
ICE_PAROLA_GIORNO_IT_IG_USER_ID=
ICE_PAROLA_GIORNO_IT_ACCESS_TOKEN=

# Pagina 4 — Oggi nella Storia
ICE_OGGI_NELLA_STORIA_IT_IG_USER_ID=
ICE_OGGI_NELLA_STORIA_IT_ACCESS_TOKEN=

# Pagina 5 — Una Domanda al Giorno
ICE_DOMANDA_GIORNO_IT_IG_USER_ID=
ICE_DOMANDA_GIORNO_IT_ACCESS_TOKEN=

# ---- App credentials — FACOLTATIVE per pubblicare --------------------------
# Verificato sulla documentazione ufficiale Meta (vedi src/core/meta_api.py):
#
#   pubblicare          non le usa. Bastano IG_USER_ID e ACCESS_TOKEN qui sopra.
#   /me                 non le usa: il token si autentica da solo.
#   /debug_token        LE RICHIEDE. Vive su graph.facebook.com e vuole un app
#                       access token, cioè META_APP_ID|META_APP_SECRET. È
#                       l'unico modo di leggere scadenza e permessi del token.
#   refresh (60 gg)     non le usa (grant_type=ig_refresh_token).
#   breve -> lungo      richiede META_APP_SECRET (grant_type=ig_exchange_token).
#
# Il preflight NON le pretende. Senza di esse, però, la scadenza del token non
# è leggibile: health-check resta in avviso e il primo go-live si ferma lì.
#
# ATTENZIONE: qui vanno le credenziali dell'app **Meta**, non quelle Instagram.
# Il Dashboard ne mostra due coppie, in due posti diversi:
#
#   App settings > Basic                        -> App ID / App secret   <-- QUESTE
#   Instagram > API setup with Instagram login  -> Instagram app ID / secret
#
# Servono a due cose diverse e non sono intercambiabili: `debug_token` è un
# endpoint di graph.facebook.com e vuole la coppia Meta, mentre lo scambio
# token breve -> lungo (`ig_exchange_token`) vuole il secret Instagram.
# Passare l'ID dell'app Instagram a debug_token risponde
# «Error validating application» (code 190): quell'ID non esiste come nodo su
# graph.facebook.com. Verificato su un account reale l'11 agosto 2026.
META_APP_ID=
META_APP_SECRET=

# Secret dell'app Instagram — serve SOLO a trasformare un token breve in uno
# long-lived (grant_type=ig_exchange_token). Non serve per pubblicare né per
# debug_token. Lascialo vuoto se il token che usi è già long-lived.
# ICE_INSTAGRAM_APP_SECRET=

# ---- Public media hosting — OPTIONAL, legacy 'hosted_url' method ONLY -------
# NOT needed with the default upload_method=resumable (direct upload to Meta:
# no public hosting, no open ports, no external storage — but only with
# api_flavor: facebook_login). Set this only if you
# deliberately switch a page/global to upload_method=hosted_url.
# ICE_PUBLIC_MEDIA_BASE_URL=

# ---- ComfyUI / local model -------------------------------------------------
ICE_COMFYUI_URL=http://127.0.0.1:8188
ICE_COMFYUI_LAUNCH_BAT=F:\AI\start_comfyui.bat
ICE_COMFYUI_OUTPUT_DIR=F:\AI\output
# Local checkpoint. Defaults already match these values; override to change the
# model WITHOUT touching any code (see docs/LOCAL_MODEL_SETUP.md).
ICE_COMFYUI_MODEL_FAMILY=sdxl
ICE_COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
ICE_COMFYUI_WORKFLOW=sdxl_background.json
# Root of the ComfyUI installation, used by scripts/install_local_model.*
ICE_COMFYUI_ROOT=F:\AI\ComfyUI

# ---- Dashboard (local only) ------------------------------------------------
ICE_DASHBOARD_HOST=127.0.0.1
ICE_DASHBOARD_PORT=8765
ICE_DASHBOARD_TOKEN=change-me-local-only
