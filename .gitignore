# ---- Secrets ----
.env
.env.*
!.env.example
*.token
*.secret
secrets/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.uv/
*.egg

# ---- Testing / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Database (runtime data, keep schema/migrations in git) ----
database/*.sqlite
database/*.sqlite-shm
database/*.sqlite-wal
database/*.db

# ---- Generated media (large, reproducible) ----
generated/backgrounds/*
generated/posts/*
generated/stories/*
generated/reels/*
generated/failed/*
generated/*.html
!generated/**/.gitkeep

# ---- Logs ----
logs/*.log
logs/*.jsonl
!logs/.gitkeep

# ---- Assets that are large / licensed ----
assets/music/**/*.mp3
assets/music/**/*.wav
assets/music/**/*.m4a
assets/music/**/*.ogg
assets/music/**/*.flac
!assets/music/**/.gitkeep
!assets/music/**/*.json
assets/music/catalog.json
!assets/music/catalog.example.json
assets/fonts/*.ttf
assets/fonts/*.otf
!assets/fonts/.gitkeep
!assets/fonts/README.md

# ---- Local generative models (multi-GB, licensed, never committed) ----
*.safetensors
*.safetensors.sha256
*.ckpt
*.pt
*.pth
models/

# ---- Dataset validation / preview reports (regenerable) ----
reports/*.json
reports/*.html
!reports/.gitkeep

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
